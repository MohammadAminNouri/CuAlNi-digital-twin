{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cualni-digitaltwin-pro:schema:am-screening-profile:1.0",
  "title": "CuAlNi-DigitalTwin Pro sourced AM screening profile",
  "type": "object",
  "required": ["metrics", "profile"],
  "properties": {
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "unit", "classification", "provenance"],
        "properties": {
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "minLength": 1},
          "provenance": {"type": "string", "minLength": 1},
          "uncertainty": {"type": ["number", "null"], "minimum": 0}
        },
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "profile": {
      "type": "object",
      "required": ["name", "version", "provenance", "applicability", "rules"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "applicability": {"type": "string", "minLength": 1},
        "grade_bands": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{"type": "number", "minimum": 0, "maximum": 10}, {"type": "string"}],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "preferred_value", "adverse_value", "weight", "unit", "rationale", "source"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "preferred_value": {"type": "number"},
              "adverse_value": {"type": "number"},
              "weight": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "A schema only. Users must supply calibrated values, bounds, weights, and sources."
}
